{
  "type": "object",
  "additionalProperties": false,
  "required": ["categories", "unreadable_images"],
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "ranking", "reason", "caveat", "defects"],
        "properties": {
          "category": { "type": "string" },
          "ranking": {
            "description": "Best first. Each inner array is one tier; letters in the same tier are tied.",
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "reason": { "type": "string" },
          "caveat": {
            "description": "Limits on judging this category from these images, such as a state no view shows or a value estimated from pixels. Empty string when there are none.",
            "type": "string"
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "view", "element", "problem", "fix"],
              "properties": {
                "label": { "type": "string" },
                "view": { "type": "string" },
                "element": { "type": "string" },
                "problem": { "type": "string" },
                "fix": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "unreadable_images": {
      "description": "Only images that are missing or cannot be read. Empty array when every image is readable. Caveats go in each category's caveat, never here.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "view"],
        "properties": {
          "label": { "type": "string" },
          "view": { "type": "string" }
        }
      }
    }
  }
}
